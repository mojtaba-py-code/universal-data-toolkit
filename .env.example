# Copy to .env and fill in.  .env is git-ignored and must never be committed.
# Every variable here is read at runtime; nothing is hard-coded in the source.

# ---------------------------------------------------------------------------
# PostgreSQL (used by configs/postgres_pipeline.yaml and docker-compose.yml)
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=datatoolkit
PGUSER=datatoolkit
PG_PASSWORD=change-me

# ---------------------------------------------------------------------------
# MySQL (optional)
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=datatoolkit
MYSQL_USER=datatoolkit
MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------------------
# API ingestion
# ---------------------------------------------------------------------------
# Bearer token used by `data-tool fetch --token-env API_TOKEN`
API_TOKEN=
# API key used by pipelines with `auth: {type: api_key, env: API_KEY}`
API_KEY=
# Optional endpoint for examples/03_api_validate_database.py
EXAMPLE_API_URL=

# ---------------------------------------------------------------------------
# Masking
# ---------------------------------------------------------------------------
# Required in production: without it every run uses a fresh random salt, so
# hashed identifiers cannot be joined across runs.
UD_MASKING_SALT=

# ---------------------------------------------------------------------------
# Safety switches
# ---------------------------------------------------------------------------
# Set to 1 only when you fully trust the pickle files you are reading.
UD_ALLOW_PICKLE=0
